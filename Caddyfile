{
    admin off
    auto_https off
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    @versioned path /css/* /js/*
    header @versioned Cache-Control "public, max-age=31536000, immutable"

    @staticFiles path /favicon.ico /robots.txt
    header @staticFiles Cache-Control "public, max-age=86400"
    php_server
}
