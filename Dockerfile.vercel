FROM dunglas/frankenphp:1-php8.5-alpine AS base

WORKDIR /app

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && apk add --no-cache ca-certificates \
    && install-php-extensions pdo_mysql mbstring intl bcmath zip opcache

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

RUN composer install --no-dev --no-scripts --no-interaction --no-progress --prefer-dist

COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY artisan ./artisan

RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && composer dump-autoload --no-dev --optimize --no-interaction

FROM base AS runtime

RUN setcap -r /usr/local/bin/frankenphp

ENV APP_ENV=production \
    APP_DEBUG=false \
    ASSET_URL=/ \
    LOG_CHANNEL=stderr \
    DB_CONNECTION=mysql \
    SESSION_DRIVER=database \
    SESSION_SECURE_COOKIE=true \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt \
    LARAVEL_STORAGE_PATH=/tmp/storage \
    VIEW_COMPILED_PATH=/tmp/storage/framework/views \
    APP_SERVICES_CACHE=/tmp/storage/framework/cache/services.php \
    XDG_CONFIG_HOME=/tmp/caddy/config \
    XDG_DATA_HOME=/tmp/caddy/data \
    PORT=80

COPY --from=dependencies /app /app
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80

CMD ["sh", "-c", "mkdir -p /tmp/storage/framework/cache/data /tmp/storage/framework/sessions /tmp/storage/framework/views /tmp/storage/logs && php artisan migrate --force && php artisan db:seed --class=SuperadminSeeder --force && exec frankenphp run --config /etc/caddy/Caddyfile"]
